#!/usr/bin/env bash
# Local launcher for genesispy-vp2vpy — no install required.
# Requires `perl` with PPI on @INC; on ramyx hosts:
#   module load ramyx/perl/5.42.0/0.1.0
# Resolve symlinks so the launcher works when linked from elsewhere (e.g. ~/bin).
src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
    dir="$(cd -P -- "$(dirname -- "$src")" && pwd)"
    src="$(readlink -- "$src")"
    [[ "$src" == /* ]] || src="$dir/$src"
done
SCRIPT_DIR="$(cd -P -- "$(dirname -- "$src")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
export PYTHONPATH="$REPO_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec "${PYTHON:-python3}" -m genesispy.tools.vp2vpy "$@"
